# 复制本文件为 apps/web/.env.local，再填入自己的值。不要提交 .env.local。

# Supabase Auth（magic link）。Dashboard API 只用登录 session，不使用 service role key。
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# 在 Supabase → Authentication → URL Configuration 里加入：
#   Site URL: http://localhost:3000
#   Redirect URLs: http://localhost:3000/auth/callback

# Postgres 连接串。Drizzle 只依赖这个变量，不调用 Supabase 的数据 API。
# 迁移请用直连（5432）。应用运行时也可以用连接池（6543）。
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
